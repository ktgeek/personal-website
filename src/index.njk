    <a href="/resume/" class="group block p-5 pixel-box bg-arcade-surface hover:border-arcade-yellow transition-all">
      <h2 class="font-pixel text-[10px] text-arcade-cyan mb-3 leading-loose group-hover:text-arcade-yellow group-hover:glow-yellow transition-colors">&gt; Resume</h2>
      <p class="text-xs">My job history and professional experience.</p>
